# GEMINI_API_KEY / AI_API_KEY: Key for external AI models (Gemini 3.7 Flash)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET="smartbuy_jwt_super_secret_key_2026"

# MONGODB_URI: MongoDB connection string (Optional: seamlessly falls back to persistent structured DB engine)
MONGODB_URI=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

